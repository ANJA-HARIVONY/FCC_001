# =============================================================================
# FCC_001 - Template de configuration pour Docker
# Copier ce fichier vers .env : cp .env.example .env
# Puis remplacer chaque valeur marquée CHANGE_ME par une valeur réelle.
# NE JAMAIS commit le fichier .env (déjà couvert par .gitignore).
# =============================================================================

# === BASE DE DONNÉES (utilisé par docker-compose) ===
DB_ROOT_PASSWORD=CHANGE_ME_root_strong_password
DB_NAME=fcc_001_db
DB_USER=fcc_user
DB_PASSWORD=CHANGE_ME_db_strong_password
DB_PORT_EXTERNAL=3307

# === APPLICATION ===
# Générer avec : openssl rand -hex 32
# En production, l'application DOIT démarrer avec une SECRET_KEY unique.
# En local (FLASK_ENV=development), une clé simple suffit pour les tests.
SECRET_KEY=dev-local-change-me-if-you-want
APP_NAME=FCC_001 - Atención al Cliente
APP_VERSION=1.0.0

# === ENVIRONNEMENT ===
# development = tests locaux (Ubuntu, Docker sur poste dev) — pas de validation stricte SECRET_KEY
# production  = serveur réel — SECRET_KEY obligatoire (openssl rand -hex 32)
FLASK_ENV=development
FLASK_APP=core/app.py

# === INITIALISATION ===
# Créer des données exemple si la base est vide (désactiver en production)
INIT_SAMPLE_DATA=true

# === SERVEUR ===
APP_PORT=8089
LOG_LEVEL=INFO
WEASYPRINT_AVAILABLE=true

# === BITRIX24 (optionnel) ===
# Webhook entrant Bitrix24 (méthode tasks.task.get). Exemple :
# BITRIX24_API=https://conexxia.bitrix24.es/rest/1/xxxxxxxxxxxxxxxx/
# Le serveur doit pouvoir joindre *.bitrix24.es en HTTPS (port 443).
# Sur un réseau isolé (ex. 10.16.15.4 sans Internet), mettre false :
# BITRIX24_ENABLED=false
# BITRIX24_API=
# BITRIX24_ENABLED=true
# Durée de validité du cache pour statuts non terminés (secondes, défaut 600 = 10 min)
# BITRIX_CACHE_TTL=600

# === RADIUS MANAGER (optionnel — fiche client) ===
# Consultation lecture seule via SysAPI get_userdata.
# RADIUS_ENABLED=true
# RADIUS_BASE_URL=http://10.26.0.4/radiusmanager/api
# RADIUS_API_USER=api
# RADIUS_API_PASS=CHANGE_ME_radius_api_password
# RADIUS_TIMEOUT_SECONDS=8
# RADIUS_CACHE_TTL_SECONDS=300
# RADIUS_CODE_MIN_DIGITS=4
# Connection status = 4 pings ICMP vers IP CPE (staticipcpe / cpeipaddress)
# RADIUS_PING_COUNT=4
# Recherche par firstname (nombre completo, luego código en firstname) — REQUERIDO:
# RADIUS_DB_HOST=10.26.0.4
# RADIUS_DB_PORT=3306
# RADIUS_DB_NAME=radius
# RADIUS_DB_USER=CHANGE_ME_radius_db_user
# RADIUS_DB_PASSWORD=CHANGE_ME_radius_db_password
# RADIUS_DB_TABLE=rm_users

# === SÉCURITÉ ===
# false en local HTTP (http://localhost:8089) ; true en production HTTPS
SESSION_COOKIE_SECURE=false
# Limite anti-DoS sur la taille d'une requête (en octets, défaut 16 Mo)
MAX_CONTENT_LENGTH=16777216

# === GUNICORN ===
WORKERS=4
TIMEOUT=120
KEEPALIVE=2

# === NGINX (si profil with-nginx) ===
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
