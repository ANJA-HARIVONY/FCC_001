{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose -f docker-compose.yml -f docker-compose.local.yml ps:*)",
      "Bash(docker compose -f docker-compose.yml -f docker-compose.local.yml logs:*)",
      "Bash(.venv/bin/python -m unittest:*)",
      "Bash(python3 -m compileall:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(.venv/bin/pybabel extract:*)",
      "Bash(.venv/bin/pybabel update:*)",
      "Bash(.venv/bin/pybabel compile:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(docker compose down:*)",
      "Bash(flask db upgrade:*)",
      "Bash(.venv/bin/flask db upgrade:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
  }
}
