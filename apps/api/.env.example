# Copier vers apps/api/.env (fichier ignoré). Ne pas y mettre de secret versionné.
# Au démarrage, l'API charge d'abord le .env à la racine du dépôt, puis ce fichier.
# Une variable déjà définie par le shell ou Docker n'est pas écrasée.
# Sans DATABASE_URL, elle est construite depuis DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
#
# Intégrations (noms seulement, valeurs dans le .env racine, jamais dans le dépôt) :
# BITRIX24_API, BITRIX24_ENABLED
# RADIUS_ENABLED, RADIUS_BASE_URL, RADIUS_API_USER, RADIUS_API_PASS, RADIUS_CACHE_TTL_SECONDS
# GEMINI_API_KEY, GEMINI_MODEL, ETATS_USE_AI
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/fcc_001_db
PORT=4000
SESSION_COOKIE_SECURE=false
# SESSION_STORE=memory
# SESSION_FILE=instance/api-sessions.json
PASSWORD_REHASH=false
WEB_ORIGIN=http://localhost:5173
